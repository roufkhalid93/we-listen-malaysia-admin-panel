# Secret used to sign admin session JWTs. Change this in production.
JWT_SECRET=we-listen-malaysia-dev-secret-change-me

# Comma-separated list of origins allowed to call the public API endpoints
# (GET /api/causes, GET /api/org-stats, POST /api/donations, POST /api/contact)
# from the separate frontend repo. Add your deployed frontend URL here too.
FRONTEND_ORIGIN=http://localhost:3000
